# External User Management Configuration

# LiteLLM Configuration
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=your-litellm-api-key-here

# External User Provider (currently supports: litellm)
EXTERNAL_USER_PROVIDER=litellm

# Default budget for new users (in USD)
DEFAULT_USER_BUDGET=10.0

# Fail user registration if external user creation fails
# Set to 'true' to fail registration, 'false' to continue without external user
FAIL_ON_EXTERNAL_USER_ERROR=false